---
import ProductCard from "@/components/products/ProductCard.astro";
import GuestTimer from "@/components/order/GuestTimer";
import ShowOrderButton from "../order/ShowOrderButton";
import BackToAdminButton from "@/components/order/BackToAdminButton";
import SignOutButton from "@/components/ui/SignOutButton";

import {
    getPage,
    getModuleByPage,
    getTable
} from "@/services/pages";

const { category } = Astro.params;

let products: any[] = [];



const page = await getPage(category!);



if (page) {

    const module = await getModuleByPage(page.id);

    

    if (module) {

       

        products = (await getTable(module.title)).map((product: any) => ({
            ...product,
            table: module.title
        }));

        

    }

}
---

<nav class="sticky top-0 z-30 bg-slate-600 border-b border-slate-500">
    <div class="flex flex-wrap items-center gap-3 justify-between py-2">
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#F3EDE0] my-3 px-1">
            Elige y Personaliza tu Pedido a continuación
        </h1>

        <div class="flex items-center gap-2">
            <BackToAdminButton client:only="react"/>
            <SignOutButton client:only="react" />
            <GuestTimer client:only="react" />
            <ShowOrderButton client:only="react" />
        </div>
    </div>
</nav>

<div class="mt-3 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 2xl:grid-cols-5 gap-4 items-stretch">
    {products.map(product => <ProductCard product={product} />)}
</div>