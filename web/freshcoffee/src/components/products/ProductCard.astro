---
import PriceWithVariants from "./PriceWithVariants.astro";
import AddProductButton from "./AddProductButton";
import ProductInfoModal from "./ProductInfoModal.astro";
import { formatCurrency } from "@/utils";

interface Props {
    product: any;
}

const { product } = Astro.props;

let isVariable = false;
let variants: any[] = [];

try {
    variants = JSON.parse(product.price);
    isVariable = Array.isArray(variants);
} catch {
    isVariable = false;
}

const description = product.description?.trim() ?? "";

const dialogId = `product-dialog-${product.table ?? "product"}-${product.id}`;
---

<div class="product-card border border-gray-200 bg-white overflow-hidden mx-auto w-full max-w-[320px] sm:max-w-none sm:mx-0">

    <div class="mt-2 w-full h-40 sm:h-auto sm:aspect-3/4 overflow-visible md:mt-0 flex items-center justify-center bg-transparent">
        <img
            src={product.image}
            alt={`Imagen de ${product.title}`}
            loading="lazy"
            class="relative z-10 w-auto h-auto max-w-full max-h-40 sm:w-full sm:h-full sm:max-h-none object-contain md:rounded-none rounded-lg transition-transform duration-300 ease-out sm:hover:z-20 sm:hover:scale-110 sm:hover:-translate-y-2"
        />
    </div>

    <div class="p-3 sm:p-4">

        <h3 class="text-lg sm:text-xl font-black line-clamp-2 mb-1">
            {product.title}
        </h3>

        {
            description && (
                <button
                    type="button"
                    class="product-description"
                    data-open-product-dialog={dialogId}
                    aria-label={`Ver información de ${product.title}`}
                >
                    {description}
                </button>
            )
        }

        {
            isVariable ? (

                <PriceWithVariants
                    product={{
                        ...product,
                        variants
                    }}
                />

            ) : (

                <>
                    <p class="mt-2 sm:mt-3 lg:mt-4 font-black text-xl sm:text-2xl text-amber-400">
                        {formatCurrency(Number(product.price))}
                    </p>

                    <AddProductButton
                        client:only="react"
                        product={{
                            id: product.id,
                            table: product.table,
                            name: product.title,
                            price: Number(product.price)
                        }}
                    />
                </>

            )
        }

    </div>

    <ProductInfoModal product={product} />

</div>

<style>
    .product-card {
        animation: product-card-enter 450ms ease-out both;
    }

    .product-description {
        display: -webkit-box;
        width: 100%;
        min-height: 2.75rem;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        text-align: left;
        font-size: 0.875rem;
        line-height: 1.375rem;
        color: rgb(71 85 105);
        cursor: pointer;
        transition: color 180ms ease;
    }

    .product-description:hover,
    .product-description:focus-visible {
        color: rgb(48, 48, 49);
    }

    @keyframes product-card-enter {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .product-card {
            animation: none;
        }
    }
</style>

