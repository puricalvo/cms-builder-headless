---
import { Picture } from "astro:assets";
import PriceWithVariants from "./PriceWithVariants.astro";
import AddProductButton from "./AddProductButton";
import { formatCurrency } from "@/utils";

interface Props {
    product: any;
}

const { product } = Astro.props;

let isVariable = false;
let variants: any[] = [];

try {

    variants = JSON.parse(product.price);

    isVariable = Array.isArray(variants);

} catch {

    isVariable = false;

}
---

<div class="border border-gray-200 mx-auto w-full max-w-[320px] sm:max-w-none sm:mx-0">
 

    <div class="w-full flex items-center justify-center h-40 sm:h-auto overflow-hidden sm:overflow-visible">
    <img
        src={product.image}
        alt={`Imagen de ${product.title}`}
        loading="lazy"
        class="w-auto h-auto max-w-full max-h-40 sm:max-h-125 md:max-h-70 lg:max-h-none object-contain sm:object-scale-down sm:rounded-none rounded-lg"
    />
</div>    

    <div class="p-3 sm:p-5">

            <h3 class="text-xl sm:text-2xl font-black sm:h-20 lg:mb-3 xl:mb-3">
                {product.title}
            </h3>

        {
            isVariable ? (

                <PriceWithVariants
                    product={{
                        ...product,
                        variants
                    }}
                />

            ) : (

                <>
                    <p class="mt-3 sm:mt-4 lg:mt-5 font-black text-xl sm:text-2xl md:text-3xl lg:text-4xl text-amber-400">
                        {formatCurrency(Number(product.price))}
                    </p>

                    <AddProductButton
                        client:only="react"
                        product={{
                            id: product.id,
                            table: product.table,
                            name: product.title,
                            price: Number(product.price)
                        }}
                    />
                </>

            )
        }

    </div>

</div>