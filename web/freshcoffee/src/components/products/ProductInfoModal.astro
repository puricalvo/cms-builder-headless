const getIngredientLabel = (value: string) => {
    const key = normalizeKey(value);

    return ingredientLabels[key] ?? value;
};

const getAllergenLabel = (value: string) => {
    const key = normalizeKey(value);

    return allergenLabels[key] ?? value;
};

const dialogId = `product-dialog-${product.table ?? "product"}-${product.id}`;
---

{
    description && (
        <dialog
            id={dialogId}
            class="product-dialog"
            aria-labelledby={`${dialogId}-title`}
        >
            <div class="product-dialog-content">

                <button
                    type="button"
                    class="product-dialog-close"
                    data-close-product-dialog
                    aria-label="Cerrar"
                >
                    ×
                </button>

                <div class="product-dialog-image">
                    <img
                        src={product.image}
                        alt={`Imagen de ${product.title}`}
                    />
                </div>

                <h2
                    id={`${dialogId}-title`}
                    class="text-xl font-black text-slate-800"
                >
                    {product.title}
                </h2>

                <p class="mt-2 text-sm leading-5 text-slate-600">
                    {description}
                </p>

                {
                    ingredients.length > 0 && (
                        <div class="mt-3">

                            <h3 class="text-base font-black text-slate-800">
                                Ingredientes
                            </h3>

                            <div class="mt-1 flex flex-wrap gap-1.5">
                                {
                                    ingredients.map((ingredient: string) => {
                                        const key = normalizeKey(ingredient);
                                        const label = getIngredientLabel(ingredient);

                                        return (
                                            <button
                                                type="button"
                                                class="product-icon-button"
                                                data-ingredient-icon
                                                data-label={label}
                                                aria-label={`Ingrediente: ${label}`}
                                                title={label}
                                            >
                                                <span aria-hidden="true">
                                                    {ingredientIcons[key] ?? "🍽️"}
                                                </span>
                                            </button>
                                        );
                                    })
                                }
                            </div>

                            <p
                                class="product-selected-label"
                                data-ingredient-label
                                aria-live="polite"
                            ></p>

                        </div>
                    )
                }

                {
                    allergens.length > 0 && (
                        <div class="mt-3">

                            <h3 class="text-base font-black text-slate-800">
                                Alérgenos
                            </h3>

                            <div class="mt-1 flex flex-wrap gap-1.5">
                                {
                                    allergens.map((allergen: string) => {
                                        const key = normalizeKey(allergen);
                                        const label = getAllergenLabel(allergen);

                                        return (
                                            <button
                                                type="button"
                                                class="product-icon-button product-icon-button-allergen"
                                                data-allergen-icon
                                                data-label={label}
                                                aria-label={`Alérgeno: ${label}`}
                                                title={label}
                                            >
                                                <span aria-hidden="true">
                                                    {allergenIcons[key] ?? "⚠️"}
                                                </span>
                                            </button>
                                        );
                                    })
                                }
                            </div>

                            <p
                                class="product-selected-label"
                                data-allergen-label
                                aria-live="polite"
                            ></p>

                            <a
                                href="/legal/alergenos"
                                class="mt-2 inline-block text-xs font-semibold text-amber-600 hover:text-amber-700 transition-colors"
                            >
                                Consulta la información sobre alérgenos
                            </a>

                        </div>
                    )
                }

                <p class="mt-3 rounded-lg bg-slate-50 px-3 py-2 text-xs leading-5 text-slate-500">
                    ⚠️ Información de ingredientes y alérgenos utilizada
                    exclusivamente para la demostración del proyecto.
                </p>

            </div>
        </dialog>
    )
}

<script>
    document.addEventListener("click", (event) => {

        const target = event.target as HTMLElement;

        const openButton = target.closest<HTMLElement>(
            "[data-open-product-dialog]"
        );

        if (openButton) {

            const dialogId =
                openButton.dataset.openProductDialog;

            if (!dialogId) return;

            const dialog = document.getElementById(
                dialogId
            ) as HTMLDialogElement | null;

            dialog?.showModal();

            return;
        }

        const closeButton = target.closest<HTMLElement>(
            "[data-close-product-dialog]"
        );

        if (closeButton) {

            const dialog = closeButton.closest(
                "dialog"
            ) as HTMLDialogElement | null;

            dialog?.close();

            return;
        }

        if (
            target instanceof HTMLDialogElement &&
            target.open &&
            target.matches(".product-dialog")
        ) {

            const rect = target.getBoundingClientRect();

            if (
                event.clientX < rect.left ||
                event.clientX > rect.right ||
                event.clientY < rect.top ||
                event.clientY > rect.bottom
            ) {
                target.close();
            }
        }

    });

    const updateSelectedLabel = (button: HTMLElement, value: string) => {
        const container = button.closest(".product-dialog-content");
        const selector = button.matches("[data-ingredient-icon]")
            ? "[data-ingredient-label]"
            : "[data-allergen-label]";
        const label = container?.querySelector(selector) as HTMLElement | null;

        if (label) {
            label.textContent = value;
        }
    };

    document.addEventListener("pointerover", (event) => {
        const button = (event.target as HTMLElement).closest<HTMLElement>(
            "[data-ingredient-icon], [data-allergen-icon]"
        );

        if (button) {
            updateSelectedLabel(button, button.dataset.label ?? "");
        }
    });

    document.addEventListener("pointerout", (event) => {
        const button = (event.target as HTMLElement).closest<HTMLElement>(
            "[data-ingredient-icon], [data-allergen-icon]"
        );
        const nextTarget = event.relatedTarget as Node | null;

        if (button && !button.contains(nextTarget)) {
            updateSelectedLabel(button, "");
        }
    });
</script>

<style>
    .product-dialog {
    position: fixed;
    inset: 0;
    align-self: center;
    justify-self: center;

    width: min(380px, calc(100vw - 32px));
    max-height: min(88vh, 680px);

    margin: auto;
    padding: 0;

    border: 0;
    border-radius: 14px;

    background: white;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);

    overflow: hidden;
}

.product-dialog::backdrop {
    background: rgba(15, 23, 42, 0.65);
}

.product-dialog-content {
    max-height: min(88vh, 680px);
    padding: 1rem;
    overflow-y: auto;
}

    .product-dialog-image {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 90px;
        margin-bottom: 0.75rem;
    }

    .product-dialog-image img {
        width: auto;
        height: 90px;
        max-width: 180px;
        object-fit: contain;
    }

    .product-dialog-close {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 9999px;
        background: rgb(241 245 249);
        color: rgb(71 85 105);
        font-size: 1.5rem;
        line-height: 1;
        transition:
            background-color 180ms ease,
            color 180ms ease;
    }

    .product-dialog-close:hover {
        background: rgb(226 232 240);
        color: rgb(30 41 59);
    }

    .product-icon-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 9999px;
        border: 1px solid rgb(226 232 240);
        background: rgb(248 250 252);
        font-size: 1.3rem;
        cursor: pointer;
        transition:
            transform 180ms ease,
            background-color 180ms ease,
            border-color 180ms ease;
    }

    .product-icon-button:hover,
    .product-icon-button:focus-visible {
        transform: translateY(-2px);
        background: rgb(255 255 255);
        border-color: rgb(245 158 11);
        outline: none;
    }

    .product-icon-button-allergen {
        background: rgb(255 251 235);
        border-color: rgb(253 230 138);
    }

    .product-selected-label {
        min-height: 1rem;
        margin-top: 0.25rem;
        font-size: 0.8rem;
        font-weight: 600;
        color: rgb(71 85 105);
    }

    @media (prefers-reduced-motion: reduce) {
        .product-icon-button {
            transition: none;
        }
    }
</style>