---
import { ClientRouter } from 'astro:transitions'
import Logo from "@/assets/logo.svg";
import CategoriesSidebar from "@/components/categories/CategoriesSidebar.astro";
import CategoriesMobile from "@/components/categories/CategoriesMobile.astro";
import Layout from "./Layout.astro";
import OrderDrawer from "@/components/order/OrderDrawer";
import Footer from "@/components/ui/Footer.astro";
---

<ClientRouter />

<Layout title="Quiosco de Pedidos">
    <div class="md:flex md:h-screen md:overflow-hidden">

        <div class="hidden md:block">
            <CategoriesSidebar />
        </div>

        <div class="md:hidden">
            <div class="flex justify-center p-3 sm:p-4">
                <Logo class="w-28 sm:w-32" />
            </div>

            <CategoriesMobile />
        </div>

        <main class="min-h-0 md:flex-1 md:h-screen md:overflow-y-auto p-5 pt-0 pb-0 bg-[#FCF8EE]">
            <slot />
            <Footer />
        </main>

        <OrderDrawer client:only="react" />

    </div>
</Layout>