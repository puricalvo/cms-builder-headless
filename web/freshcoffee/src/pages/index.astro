---
import AuthLayout from '@/layouts/AuthLayout.astro';
import { actions } from "astro:actions";

const result = Astro.getActionResult(actions.auth.startGuestSession);

if (result?.data) {
    return Astro.redirect("/order/pricecafe");
}
---

<AuthLayout title="Bienvenido">

    <div class="flex flex-col gap-3 items-center mt-8">

        <!-- Aviso del proyecto -->
        <div class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-center">

            <p class="text-base font-black text-slate-700">
                ⚠️ Proyecto de demostración
            </p>

            <p class="mt-1 text-sm leading-5 text-slate-600">
                FreshCoffee es una aplicación de demostración para portfolio.
                No es un establecimiento real y los pedidos no serán procesados.
            </p>

            <p class="mt-1 text-xs font-semibold leading-5 text-slate-500">
                Puedes explorar el quiosco como invitado.
                No introduzcas datos personales ni contraseñas reales.
            </p>

        </div>


        <!-- Mensaje cuando termina la sesión de invitado -->
        <div
            id="guest-expired-message"
            class="hidden w-full rounded-lg border border-amber-400 bg-amber-50 px-3 py-2 text-center text-sm font-semibold leading-5 text-gray-900"
        >
            Tu sesión de invitado ha terminado. Puedes comenzar de nuevo como invitado
            o iniciar sesión para continuar.
        </div>


        <!-- Acceso como invitado -->
        <form
            action={actions.auth.startGuestSession}
            method="POST"
            class="w-full"
        >
            <button
                type="submit"
                class="w-full cursor-pointer rounded-lg border border-amber-400 px-5 py-2.5 text-2xl font-black uppercase hover:bg-amber-400"
            >
                Comenzar como invitado
            </button>
        </form>


        <!-- Inicio de sesión -->
        <a
            href="/auth/login"
            class="rounded-lg border border-amber-400 px-5 py-2.5 text-2xl font-black uppercase hover:bg-amber-400"
        >
            Iniciar Sesión
        </a>


        <!-- Registro -->
        <a
            href="/auth/register"
            class="rounded-lg border border-amber-400 px-5 py-2.5 text-2xl font-black uppercase hover:bg-amber-400"
        >
            Registrarse
        </a>

    </div>

</AuthLayout>


<script>

    const GUEST_TIME = 2 * 60 * 1000;

    const form = document.querySelector(
        'form[action*="startGuestSession"]'
    );

    form?.addEventListener("submit", () => {

        const started =
            localStorage.getItem(
                "freshcoffee-guest-started"
            );

        if (started) {

            const elapsed =
                Date.now() - Number(started);

            if (elapsed >= GUEST_TIME) {

                localStorage.setItem(
                    "freshcoffee-order",
                    JSON.stringify({
                        state: {
                            isOrderDrawerOpen: false,
                            order: []
                        },
                        version: 0
                    })
                );

                localStorage.removeItem(
                    "freshcoffee-guest-started"
                );

            }

        }

        localStorage.setItem(
            "freshcoffee-guest-started",
            Date.now().toString()
        );

    });


    const expiredMessage = document.querySelector(
        "#guest-expired-message"
    );

    const guestExpired =
        localStorage.getItem(
            "freshcoffee-guest-expired"
        );

    if (guestExpired === "true") {

        expiredMessage?.classList.remove("hidden");

        localStorage.removeItem(
            "freshcoffee-guest-expired"
        );

    }

</script>