---
import { actions } from "astro:actions"
import AuthLayout from "@/layouts/AuthLayout.astro";
import { isInputError } from "astro:actions";
import ErrorMessage from "@/components/ui/ErrorMessage.astro";
import { isActionError } from "astro:actions";


const result = Astro.getActionResult(actions.auth.signInUser)
const inputErrors = isInputError(result?.error) ? result.error.fields : {}
const actionError = isActionError(result?.error) ? result.error.message : null

if(result?.data?.success) {

    if(result.data.role === "admin") {
        return Astro.redirect('/admin')
    }

    if(result.data.role === "customer") {
        return Astro.redirect('/order/pricecafe')
    }

}


if(result?.data && !result.data.success) {
    return Astro.redirect('/404')
}


---

<AuthLayout title="Iniciar Sesión">
    {actionError && <ErrorMessage>{actionError}</ErrorMessage>}

    <form 
        action={actions.auth.signInUser} 
        method="POST" 
        class="space-y-6 mt-5 w-full" 
        novalidate
    >

        <div>
            <label
                for="email"
                class="block text-sm/6 font-medium text-gray-900"
            >
                Email:
            </label>

            <div class="mt-2">
                <input
                    type="email"
                    name="email"
                    id="email"
                    class="block w-full rounded-md bg-white px-3 py-1.5 text-base
                    text-gray-900 outline-1 -outline-offset-1 outline-gray-300
                    placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2
                    focus:outline-amber-600 sm:text-sm/6"
                />
            </div>

            {inputErrors.email && (
                <ErrorMessage>{inputErrors.email}</ErrorMessage>
            )}
        </div>


        <div>
            <label
                for="password"
                class="block text-sm/6 font-medium text-gray-900"
            >
                Password:
            </label>

            <div class="mt-2">
                <input
                    type="password"
                    name="password"
                    id="password"
                    class="block w-full rounded-md bg-white px-3
                    py-1.5 text-base text-gray-900 outline-1
                    -outline-offset-1 outline-gray-300
                    placeholder:text-gray-400 focus:outline-2
                    focus:-outline-offset-2 focus:outline-amber-600
                    sm:text-sm/6"
                />
            </div>

            {inputErrors.password && (
                <ErrorMessage>{inputErrors.password}</ErrorMessage>
            )}
        </div>


        <div>
            <button
                type="submit"
                class="flex w-full justify-center rounded-md bg-black px-3 p-2
                font-bold text-lg text-white shadow-xs focus-visible:outline-2
                focus-visible:outline-offset-2 focus-visible:outline-amber-600 cursor-pointer"
            >
                Iniciar Sesión
            </button>
        </div>

    </form>

</AuthLayout>




