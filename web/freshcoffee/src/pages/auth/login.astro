---
import { actions } from "astro:actions";
import AuthLayout from "@/layouts/AuthLayout.astro";
import { isInputError } from "astro:actions";
import ErrorMessage from "@/components/ui/ErrorMessage.astro";
import { isActionError } from "astro:actions";
import LoginBlockedNotification from "@/components/ui/LoginBlockedNotification";


const result = Astro.getActionResult(actions.auth.signInUser);

const inputErrors =
    isInputError(result?.error)
        ? result.error.fields
        : {};

const actionError =
    isActionError(result?.error)
        ? result.error.message
        : null;


// =====================================
// COMPROBAR SI LA CUENTA ESTÁ BLOQUEADA
// =====================================

const isBlocked =
    result?.data?.blocked === true;


// =====================================
// LOGIN CORRECTO
// =====================================

if (result?.data?.success) {

    if (result.data.role === "admin") {
        return Astro.redirect("/admin");
    }

    if (result.data.role === "customer") {
        return Astro.redirect("/order/pricecafe");
    }

}


// =====================================
// LOGIN INCORRECTO
// =====================================
//
// Si está bloqueado NO vamos a /404.
// Dejamos que el navegador muestre el toast
// y después redirija al registro.
//

if (
    result?.data &&
    !result.data.success &&
    !isBlocked
) {

    return Astro.redirect("/404");
}

---

<AuthLayout title="Iniciar Sesión">

    <div class="flex flex-col gap-4">

        <!-- Aviso del proyecto -->
        <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-center">

            <p class="text-base font-black text-slate-700">
                ⚠️ Proyecto de demostración
            </p>

            <p class="mt-1 text-sm leading-5 text-slate-600">
                FreshCoffee no es un servicio real y los pedidos no serán procesados.
            </p>

            <p class="mt-1 text-xs font-semibold leading-5 text-slate-500">
                No introduzcas datos personales ni contraseñas reales.
            </p>

        </div>


        {actionError && (
            <ErrorMessage>
                {actionError}
            </ErrorMessage>
        )}


        <form
            action={actions.auth.signInUser}
            method="POST"
            class="space-y-6 w-full"
            novalidate
        >

            <div>

                <label
                    for="email"
                    class="block text-sm/6 font-medium text-gray-900"
                >
                    Email:
                </label>

                <div class="mt-2">

                    <input
                        type="email"
                        name="email"
                        id="email"
                        class="block w-full rounded-md bg-white px-3 py-1.5
                        text-base text-gray-900 outline-1
                        -outline-offset-1 outline-gray-300
                        placeholder:text-gray-400 focus:outline-2
                        focus:-outline-offset-2 focus:outline-amber-600
                        sm:text-sm/6"
                    />

                </div>

                {inputErrors.email && (
                    <ErrorMessage>
                        {inputErrors.email}
                    </ErrorMessage>
                )}

            </div>


            <div>

                <label
                    for="password"
                    class="block text-sm/6 font-medium text-gray-900"
                >
                    Password:
                </label>

                <div class="mt-2">

                    <input
                        type="password"
                        name="password"
                        id="password"
                        class="block w-full rounded-md bg-white px-3
                        py-1.5 text-base text-gray-900 outline-1
                        -outline-offset-1 outline-gray-300
                        placeholder:text-gray-400 focus:outline-2
                        focus:-outline-offset-2 focus:outline-amber-600
                        sm:text-sm/6"
                    />

                </div>

                {inputErrors.password && (
                    <ErrorMessage>
                        {inputErrors.password}
                    </ErrorMessage>
                )}

            </div>


            <div>

                <button
                    type="submit"
                    class="flex w-full justify-center rounded-md bg-black
                    px-3 p-2 font-bold text-lg text-white shadow-xs
                    focus-visible:outline-2 focus-visible:outline-offset-2
                    focus-visible:outline-amber-600 cursor-pointer"
                >
                    Iniciar Sesión
                </button>

            </div>

        </form>


        <!-- Notificación exclusiva de login -->
        <LoginBlockedNotification
            show={isBlocked}
            client:only="react"
        />


        <!-- Volver -->
        <a
            href="/"
            class="text-center text-sm font-semibold text-slate-600 transition-colors hover:text-amber-500"
        >
            ← Volver
        </a>

    </div>

</AuthLayout>