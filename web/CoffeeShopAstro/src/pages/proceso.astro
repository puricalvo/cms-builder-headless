---
import Layout from "@/layouts/Layout.astro";
import { getPage, getTable } from "@/services/pages";
import { decode } from "@/services/utils";

const page = await getPage("proceso");

const procesos = await getTable("procesos");

const proceso = procesos[0];
const bloques = procesos.slice(1);
---

<Layout
    title={decode(page?.title_page ?? "Proceso")}
    subtitle={decode(proceso?.subtitle_proceso ?? "")}
    bgImage={decode(proceso?.image_proceso ?? "")}
>

    <div
        class="text-xl space-y-3 mt-10 lg:mt-0"
        set:html={decode(proceso?.description_proceso ?? "")}
    />

    <div class="mt-10 space-y-10">
        {bloques.map((bloque: any, i: number) => (
            <section class="flex flex-col lg:flex-row lg:items-center gap-10">

                <div class={`w-full lg:w-1/2 ${i % 2 === 0 ? 'lg:order-1' : 'lg:order-2'}`}>
                    <img
                        src={decode(bloque?.image_proceso ?? "")}
                        alt={decode(bloque?.title_proceso ?? "")}
                        loading="lazy"
                    />
                </div>

                <div class={`w-full lg:w-1/2 ${i % 2 === 0 ? 'lg:order-2' : 'lg:order-1'}`}>
                    <h3 class="text-coffee-900 font-black text-4xl pb-10 uppercase">
                        {decode(bloque?.title_proceso ?? "")}
                    </h3>

                    <div
                        class="text-lg"
                        set:html={decode(bloque?.description_proceso ?? "")}
                    />
                </div>

            </section>
        ))}
    </div>

</Layout>