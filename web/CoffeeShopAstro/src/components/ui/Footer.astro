---
import FooterBox from "./FooterBox.astro";
---

<footer class="bg-coffee-900 pt-20">

    <div class="max-w-7xl mx-auto mt-10 grid grid-cols-1 lg:grid-cols-3 gap-5">

        <FooterBox heading="Ubicación">
            <p>Luis Montoto 39</p>
            <p>Sevilla, ES</p>
        </FooterBox>

        <FooterBox heading="Reservación">
            <p>Tel. 3850-9102</p>
            <a href="tel:+3850-9102">Llamar</a>
        </FooterBox>

        <FooterBox heading="Horario">
            <p>Lun-Jue: 11:00 - 22:00</p>
            <p>Vie-Sab: 09:00 - 24:00</p>
            <p>Domingo: Cerrado</p>
        </FooterBox>

    </div>

    <div class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-3 text-lg text-white">

        <a
            href="/legal/alergenos"
            class="hover:text-coffee-400 transition-colors"
        >
            Alérgenos
        </a>

        <a
            href="/legal/privacidad"
            class="hover:text-coffee-400 transition-colors"
        >
            Privacidad
        </a>

        <a
            href="/legal/cookies?from=home"
            class="hover:text-coffee-400 transition-colors"
        >
            Cookies
        </a>

        <a
            href="/legal/aviso-legal"
            class="hover:text-coffee-400 transition-colors"
        >
            Aviso legal
        </a>

    </div>

    <p class="py-10 text-center text-white text-sm">
        Todos los derechos reservados. La Cafetería1939.
        &copy; {new Date().getFullYear()}
    </p>

</footer>