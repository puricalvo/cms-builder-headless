---
import { formatAmount } from "@/helpers";
import ProductInfoModal from "./ProductInfoModal.astro";

interface Props {
    table: string;
    id: string | number;
    title: string;
    subtitle: string;
    price: number;
    image: string;
    ingredients: string[];
    allergens: string[];
}

const {
    table,
    id,
    title,
    subtitle,
    price,
    image,
    ingredients,
    allergens
} = Astro.props;

const dialogId = `product-dialog-${table}-${id}`;

const width = 1200;
const height = 800;


---

<li class="flex flex-col md:flex-row lg:justify-between gap-5 w-full md:items-center p-5">

    <div class="flex-1 flex flex-col md:flex-row gap-5 items-center">

        <div class="w-full md:w-40 lg:w-56 overflow-hidden">

            <a
                href={image}
                data-pswp-width={width}
                data-pswp-height={height}
            >
                <img
                    src={image}
                    alt={`Imagen del menú: ${title}`}
                    loading="lazy"
                    class="w-full h-64 md:h-40 object-cover border-8 border-white"
                />
            </a>

        </div>

        <div class="flex-1">

            <p class="text-white font-bold text-2xl text-center md:text-left">
                {title}
            </p>

            <button
                type="button"
                data-open-product-dialog={dialogId}
                class="menu-subtitle text-white/80 text-lg text-center md:text-left w-full p-0 bg-transparent border-0 cursor-pointer"
                aria-label={`Ver información de ${title}`}
            >
                {subtitle}
            </button>

        </div>

    </div>

    <p class="text-4xl font-black text-white text-center md:text-left">
        {formatAmount(price)}
    </p>

</li>

<ProductInfoModal
    product={{
        table,
        id,
        title,
        subtitle,
        image,
        ingredients,
        allergens
    }}
/>

<slot />

<script>
    document.addEventListener("click", (event) => {

        const target = event.target as HTMLElement;

        const button = target.closest<HTMLElement>(
            "[data-open-product-dialog]"
        );

        if (!button) return;

        const dialogId = button.dataset.openProductDialog;

        if (!dialogId) return;

        const dialog = document.getElementById(
            dialogId
        ) as HTMLDialogElement | null;

        dialog?.showModal();
    });
</script>

<style>
    .menu-subtitle {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>