---
interface Props {
    name: string;
    slug?: string;
}

const { name, slug } = Astro.props;
---

{slug ? (
    <a
        href={`/blog/categoria/${slug}`}
        class="inline-flex items-center px-4 py-1.5 mr-2 mb-2 text-xs font-semibold  text-white bg-coffee-600 rounded-full hover:bg-coffee-700 transition-colors"
    >
        {name.charAt(0).toUpperCase() + name.slice(1).toLowerCase()}
    </a>
) : (
    <span
        class="inline-flex items-center px-4 py-1.5 mr-2 mb-2 text-xs font-semibold  text-white bg-coffee-600 rounded-full"
    >
        {name.charAt(0).toUpperCase() + name.slice(1).toLowerCase()}
    </span>
)}

