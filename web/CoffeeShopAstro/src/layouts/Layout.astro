---
   /*  import { ClientRouter } from 'astro:transitions' */
    import "@/styles/global.css"; 
	import Footer from "@/components/ui/Footer.astro";
    import Header from "@/components/ui/Header.astro";

    interface Props {
        title: string
        subtitle: string
        bgImage: string
    }
    const { title, subtitle, bgImage } = Astro.props
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cafeteria desde 1939: {title} </title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=PT+Sans:wght@400;700&display=swap" 
      rel="stylesheet">
     <!-- <ClientRouter />  -->
</head>
<body class="bg-coffee-50">
    <Header 
        bgImage={bgImage}
        subtitle={subtitle}
    />

    <slot name="before-main-content"/>
    
    <main 
        class="bg-white p-10 lg:p-20 max-w-7xl mx-auto lg:-mt-20 relative"
        
    >
            <h2 class="text-coffee-900 font-black text-center text-4xl pb-10 uppercase after:coffee-icon" set:html={title}></h2>
            <slot />
    </main>

    <slot name="after-main-content"/>
    <Footer /> 

    <script type="module">
        import "@/scripts/blogModal";
    </script>
</body>
</html>
